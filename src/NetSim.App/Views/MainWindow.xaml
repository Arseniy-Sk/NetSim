<Window x:Class="NetSim.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NetSim.App.Localization"
        xmlns:c="clr-namespace:NetSim.App.Controls"
        xmlns:vm="clr-namespace:NetSim.App.ViewModels"
        Title="{Binding WindowTitle}" Width="1400" Height="860" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}">
    <Window.Resources>
        <c:EnumEqualsConverter x:Key="EnumEq" />
        <c:BoolToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoActionCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoActionCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
        <KeyBinding Key="F6" Command="{Binding PauseCommand}" />
        <KeyBinding Key="F7" Command="{Binding StopCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding GoUpCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Главное меню -->
        <Menu DockPanel.Dock="Top" Padding="2" Background="White">
            <MenuItem Header="{l:T Menu_File}">
                <MenuItem Header="{l:T Menu_New}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{l:T Menu_Open}" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem x:Name="RecentMenu" Header="{l:T Menu_Recent}" SubmenuOpened="RecentMenu_Opened">
                    <MenuItem Header="…" />
                </MenuItem>
                <MenuItem Header="{l:T Menu_Samples}">
                    <MenuItem Header="{l:T Sample_Techno}" Command="{Binding OpenSampleCommand}" CommandParameter="techno" />
                    <MenuItem Header="{l:T Sample_Hier}" Command="{Binding OpenSampleCommand}" CommandParameter="hier" />
                    <MenuItem Header="{l:T Sample_IpDemo}" Command="{Binding OpenSampleCommand}" CommandParameter="ip-demo" />
                    <MenuItem Header="{l:T Sample_WifiOffice}" Command="{Binding OpenSampleCommand}" CommandParameter="wifi-office" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:T Menu_Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{l:T Menu_SaveAs}" Command="{Binding SaveAsCommand}" />
                <MenuItem Header="{l:T Menu_ExportPng}" Click="ExportPng_Click" />
                <MenuItem Header="{l:T Menu_WordReport}" Click="Report_Click" FontWeight="SemiBold" />
                <Separator />
                <MenuItem Header="{l:T Menu_ProjectSettings}" Command="{Binding ProjectSettingsCommand}" />
                <Separator />
                <MenuItem Header="{l:T Menu_Exit}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{l:T Menu_Edit}">
                <MenuItem Header="{l:T Menu_Undo}" Command="{Binding UndoActionCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{l:T Menu_Redo}" Command="{Binding RedoActionCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="{l:T Menu_Configure}" Command="{Binding ConfigureSelectedCommand}" />
                <MenuItem Header="{l:T Menu_Delete}" Command="{Binding DeleteSelectedCommand}" InputGestureText="Del" />
            </MenuItem>
            <MenuItem Header="{l:T Menu_View}">
                <MenuItem Header="{l:T Menu_MediaColors}" Command="{Binding ShowMediaColorsCommand}" />
                <MenuItem Header="{l:T Menu_ShowFlows}" IsCheckable="True" IsChecked="{Binding ShowFlows}" />
                <MenuItem Header="{l:T Menu_ShowLinkLabels}" IsCheckable="True" IsChecked="{Binding ShowLinkLabels}" />
                <Separator />
                <MenuItem Header="{l:T Menu_ZoomIn}" Click="ZoomIn_Click" InputGestureText="Ctrl+Wheel" />
                <MenuItem Header="{l:T Menu_ZoomOut}" Click="ZoomOut_Click" />
                <MenuItem Header="{l:T Menu_Zoom100}" Click="Zoom100_Click" />
                <MenuItem Header="{l:T Menu_ZoomFit}" Click="ZoomFit_Click" />
                <Separator />
                <MenuItem Header="{l:T Menu_Language}">
                    <MenuItem Header="Русский" Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                    <MenuItem Header="English" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{l:T Menu_Plan}">
                <MenuItem Header="{l:T Menu_PlanWizard}" Command="{Binding PlanWizardCommand}" />
                <MenuItem Header="{l:T Menu_PlanSettings}" Command="{Binding PlanSettingsCommand}" />
                <MenuItem Header="{l:T Menu_PlanWall}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:ToolMode.Wall}" />
                <MenuItem Header="{l:T Menu_PlanRoom}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static vm:ToolMode.Room}" />
                <Separator />
                <MenuItem Header="{l:T Menu_Coverage}" Command="{Binding ShowCoverageAnalysisCommand}" />
                <MenuItem Header="{l:T Menu_ShowCoverage}" IsCheckable="True" IsChecked="{Binding ShowCoverage}" />
                <MenuItem Header="{l:T Menu_TogglePlan}" Command="{Binding TogglePlanCommand}" />
                <Separator />
                <MenuItem Header="{l:T Menu_ClearPlan}" Command="{Binding ClearPlanCommand}" />
            </MenuItem>
            <MenuItem Header="{l:T Menu_Global}">
                <MenuItem Header="{l:T Menu_DataFlow}" Command="{Binding ShowDataFlowCommand}" />
                <MenuItem Header="{l:T Menu_Report}" Command="{Binding ShowReportCommand}" />
                <MenuItem Header="{l:T Menu_StatItems}" Command="{Binding StatisticsForSelectedCommand}" />
            </MenuItem>
            <MenuItem Header="{l:T Menu_Simulation}">
                <MenuItem Header="{l:T Menu_Run}" Command="{Binding RunCommand}" InputGestureText="F5" />
                <MenuItem Header="{l:T Menu_Pause}" Command="{Binding PauseCommand}" InputGestureText="F6" />
                <MenuItem Header="{l:T Menu_Stop}" Command="{Binding StopCommand}" InputGestureText="F7" />
                <MenuItem Header="{l:T Menu_Reset}" Command="{Binding ResetSimulationCommand}" />
                <Separator />
                <MenuItem Header="{l:T Menu_ModeProtocol}" IsCheckable="True" IsChecked="{Binding IsProtocolMode}" />
            </MenuItem>
            <MenuItem Header="{l:T Menu_Tools}">
                <MenuItem Header="{l:T Menu_Calculators}" Command="{Binding ShowCalculatorsCommand}" />
                <MenuItem Header="{l:T Menu_Console}" Command="{Binding ConsoleForSelectedCommand}" />
            </MenuItem>
            <MenuItem Header="{l:T Menu_Help}">
                <MenuItem Header="{l:T Menu_HelpLabs}" Command="{Binding ShowHelpCommand}" InputGestureText="F1" />
                <MenuItem Header="{l:T Menu_About}" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBarTray DockPanel.Dock="Top" Background="#EEF1F5">
            <ToolBar Band="0">
                <Button Style="{StaticResource ToolButton}" Command="{Binding NewProjectCommand}" ToolTip="{l:T Menu_New}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenProjectCommand}" ToolTip="{l:T Menu_Open}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip="{l:T Menu_Save}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoActionCommand}" ToolTip="{l:T Menu_Undo}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RedoActionCommand}" ToolTip="{l:T Menu_Redo}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" /></Button>
            </ToolBar>
            <ToolBar Band="0">
                <RadioButton Style="{StaticResource ToolToggle}" GroupName="tool" ToolTip="{l:T Tool_Select}"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumEq}, ConverterParameter=Select}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,1 L2,15 L6,11 L9,17 L11,16 L8,10 L13,10 Z" Fill="#2B3A4A" Width="14" Height="17" Stretch="Uniform" />
                        <TextBlock Text="{l:T Tool_SelectShort}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolToggle}" GroupName="tool" ToolTip="{l:T Tool_Link}"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumEq}, ConverterParameter=Link}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,13 A2.5,2.5 0 1 1 3,13.01 M15,3 A2.5,2.5 0 1 1 15,3.01 M4.5,11.5 L13.5,4.5" Stroke="#2F6FC0" StrokeThickness="2" Fill="#2F6FC0" Width="18" Height="16" Stretch="Uniform" />
                        <TextBlock Text="{l:T Tool_LinkShort}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolToggle}" GroupName="tool" ToolTip="{l:T Tool_Traffic}"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumEq}, ConverterParameter=Traffic}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9,0 L2,10 H7 L5,18 L13,7 H8 Z" Fill="#E3A21A" Stroke="#8A5A00" StrokeThickness="0.8" Width="14" Height="18" Stretch="Uniform" />
                        <TextBlock Text="{l:T Tool_TrafficShort}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolToggle}" GroupName="tool" ToolTip="{l:T Tool_Delete}"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumEq}, ConverterParameter=Delete}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Foreground="#C8463D" />
                </RadioButton>
                <RadioButton Style="{StaticResource ToolToggle}" GroupName="tool" ToolTip="{l:T Tool_Wall}"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumEq}, ConverterParameter=Wall}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="5" Fill="#46464F" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Tool_WallShort}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolToggle}" GroupName="tool" ToolTip="{l:T Tool_Room}"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumEq}, ConverterParameter=Room}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="12" Stroke="#46464F" StrokeThickness="2" Fill="#FFF8E1" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Tool_RoomShort}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ToolToggle}" GroupName="tool" ToolTip="{l:T Tool_Pdu}"
                             IsChecked="{Binding Tool, Converter={StaticResource EnumEq}, ConverterParameter=Pdu}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE715;" Foreground="#B0306A" />
                        <TextBlock Text="PDU" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </ToolBar>
            <ToolBar Band="0">
                <Button Style="{StaticResource ToolButton}" Command="{Binding RunCommand}" ToolTip="{l:T Menu_Run}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="#2E8B3E" />
                        <TextBlock Text="Run" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="{l:T Menu_Pause}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding StopCommand}" ToolTip="{l:T Menu_Stop}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Foreground="#C8463D" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ResetSimulationCommand}" ToolTip="{l:T Menu_Reset}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" /></Button>
                <TextBlock Text="{l:T Tool_Speed}" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox Width="70" SelectedValue="{Binding Speed}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="×0.1" Tag="{x:Static vm:SpeedValues.S01}" />
                    <ComboBoxItem Content="×0.5" Tag="{x:Static vm:SpeedValues.S05}" />
                    <ComboBoxItem Content="×1" Tag="{x:Static vm:SpeedValues.S1}" />
                    <ComboBoxItem Content="×5" Tag="{x:Static vm:SpeedValues.S5}" />
                    <ComboBoxItem Content="×20" Tag="{x:Static vm:SpeedValues.S20}" />
                    <ComboBoxItem Content="×100" Tag="{x:Static vm:SpeedValues.S100}" />
                </ComboBox>
                <TextBlock Text="{Binding SimTimeText}" VerticalAlignment="Center" Margin="10,0,4,0" FontFamily="Consolas" MinWidth="140" />
            </ToolBar>
            <ToolBar Band="0">
                <ToggleButton IsChecked="{Binding IsProtocolMode}" Padding="6,3" ToolTip="{l:T Tool_ModeTip}">
                    <TextBlock Text="{l:T Tool_ModeProtocol}" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ConsoleForSelectedCommand}" ToolTip="{l:T Menu_Console}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ShowDataFlowCommand}" ToolTip="{l:T Menu_DataFlow}"><TextBlock Text="Data Flow" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ShowReportCommand}" ToolTip="{l:T Menu_Report}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" /></Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ShowCalculatorsCommand}" ToolTip="{l:T Menu_Calculators}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8EF;" /></Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="#E6EAF0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="100%" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="180" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="170" MinHeight="60" />
            </Grid.RowDefinitions>

            <!-- Браузер оборудования -->
            <TabControl Grid.Column="0" Grid.RowSpan="3" Margin="4,4,0,4">
                <TabItem Header="{l:T Tab_Devices}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,4">
                            <TextBox Text="{Binding CatalogFilter, UpdateSourceTrigger=PropertyChanged}" Padding="22,3,3,3" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" HorizontalAlignment="Left" Margin="6,0,0,0" FontSize="12" Foreground="Gray" IsHitTestVisible="False" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Text="{l:T Catalog_Hint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="4" />
                        <TreeView x:Name="CatalogTree" ItemsSource="{Binding CatalogTree}" BorderThickness="0"
                                  PreviewMouseLeftButtonDown="CatalogTree_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="CatalogTree_PreviewMouseMove"
                                  MouseDoubleClick="CatalogTree_MouseDoubleClick">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}" />
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <Image Source="{Binding Icon}" Width="22" Height="22" />
                                        <TextBlock Text="{Binding Title}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{l:T Tab_Profiles}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{l:T Profiles_Hint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="4" />
                        <ListBox x:Name="ProfilesList" BorderThickness="0" MouseDoubleClick="ProfilesList_MouseDoubleClick" />
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Рабочее поле -->
            <DockPanel Grid.Column="2" Grid.Row="0" Margin="0,4,0,0">
                <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" Padding="4,3">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" Padding="6,1" Margin="0,0,6,0" ToolTip="{l:T Nav_UpTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="12" />
                                <TextBlock Text="{l:T Nav_Up}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text=" › " Foreground="Gray" VerticalAlignment="Center" />
                                        <Button Content="{Binding Title}" Padding="4,0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                                Command="{Binding DataContext.GoToLevelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Level}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
                        <c:TopologyView x:Name="Topology" />
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="2" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Нижняя панель: сообщения и события -->
            <TabControl Grid.Column="2" Grid.Row="2" Margin="0,0,0,4">
                <TabItem Header="{l:T Tab_Messages}">
                    <ListView ItemsSource="{Binding Messages}" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" Foreground="Gray" Width="60" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B3261E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabItem>
                <TabItem Header="{l:T Tab_Events}">
                    <DataGrid ItemsSource="{Binding ProtocolEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Ev_Time}" Binding="{Binding Time, StringFormat=0.000}" Width="80" />
                            <DataGridTextColumn Header="{l:T Ev_Device}" Binding="{Binding Device}" Width="140" />
                            <DataGridTextColumn Header="{l:T Ev_Protocol}" Binding="{Binding Protocol}" Width="70" />
                            <DataGridTextColumn Header="{l:T Ev_Info}" Binding="{Binding Info}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Свойства выделенного объекта -->
            <Border Grid.Column="4" Grid.RowSpan="3" Margin="0,4,4,4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <c:PropertiesPanel x:Name="Properties" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
